{
  "system": {
    "name": "Global Revenue Hunter",
    "version": "1.1.0",
    "default_currency": "USD",
    "maximum_results_per_query": 30,
    "request_timeout_seconds": 20,
    "minimum_score_for_review": 25,
    "minimum_score_for_priority": 55,
    "allow_initial_capital": false,
    "github_recent_update_days": 45
  },
  "github_queries": [
    {
      "name": "GitHub Explicit USD Bounties",
      "category": "open_source_bounty",
      "query": "is:issue is:open archived:false (bounty OR reward OR paid) (USD OR USDC OR \"$\") in:title,body"
    },
    {
      "name": "GitHub Algora Bounties",
      "category": "open_source_bounty",
      "query": "is:issue is:open archived:false algora (bounty OR reward OR paid) in:title,body"
    },
    {
      "name": "GitHub Reward Labels",
      "category": "open_source_bounty",
      "query": "is:issue is:open archived:false (label:bounty OR label:reward) (USD OR USDC OR \"$\") in:title,body"
    },
    {
      "name": "GitHub Crypto Bounties",
      "category": "crypto_bounty",
      "query": "is:issue is:open archived:false bounty (USDC OR USD OR ETH) in:title,body"
    },
    {
      "name": "GitHub Paid AI Tasks",
      "category": "ai_bounty",
      "query": "is:issue is:open archived:false (bounty OR paid) (\"AI agent\" OR MCP) (USD OR USDC OR \"$\") in:title,body"
    }
  ],
  "rss_sources": [
    {
      "name": "HackerOne Blog",
